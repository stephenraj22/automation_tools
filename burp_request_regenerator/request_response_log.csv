:""oam""},{developItemTitle:""近距离通信"",developItemText:""为您提供便捷的周边设备的快速发现，快速连接，数据传输的能力。为您便捷地发现周边蓝牙信标消息，为用户提供智能的场景化服务。"",pic:i(1860),page_name:""neabyservice""},{developItemTitle:""数据融合"",developItemText:""通过端云一体的数据融合，使分布式环境中多设备上的数据和云端存储的数据统一视图。为分布式应用开发带来便利，让开发者在一台设备上都可以无感的访问到其它设备和云端存储的数据。"",pic:i(1861),page_name:""distributeddatamanagement""}]},{developTitle:""系统能力"",developItemData:[{developItemTitle:""相机服务"",developItemText:""相机能力（CameraUnit） 是 OPPO 影像能力开放接口，可消除系统影像能力与三方应用间的隔阂，用户在三方应用中也能获得与 OPPO 相机一致的拍摄体验。"",pic:i(1862),page_name:""camera""},{developItemTitle:""多媒体服务"",developItemText:""多媒体能力（MediaUnit） 是 OPPO 多媒体能力开放接口，旨在解决三方应用经常遇到的影音播放痛点问题，得到视觉和听觉上更加丰富、优质的产品体验。"",pic:i(1863),page_name:""media""},{developItemTitle:""相册服务"",developItemText:""相册能力可有效提升相册图片的加载速度，支持智能识别、多标签智能搜索，提升用户找图、管理图片的效率。"",pic:i(1864),page_name:""photo""},{developItemTitle:""AR 服务"",developItemText:""面向开发者提供的AR服务，帮助开发者探索更加新颖、有创意、体验非凡的应用场景。"",pic:i(1865),page_name:""ar""},{developItemTitle:""Hyper Boost"",developItemText:""OPPO 自主研发的全场景、系统级资源调度优化方案，从系统、游戏和应用三个层面对手机加速。"",pic:i(1866),page_name:""hyperboost""},{developItemTitle:""物光引擎服务"",developItemText:""物光引擎是OPPO的光线追踪能力开放接口。此引擎赋能开发者在三方应用中使用光线追踪的功能，获得新世代视觉体验。"",pic:i(1867),page_name:""physray""}]},{developTitle:""安全服务"",developItemData:[{developItemTitle:""恶意URL检测"",developItemText:""提供URL安全检测能力，判断用户访问的URL是否为恶意网址， 应用可基于检测结果评估如何响应。"",pic:i(1868),page_name:""urldetect""},{developItemTitle:""终端环境安全检测"",developItemText:""对Android客户端环境进行动态检测：如ROOT、模拟器、调试等，判断设备环境是否安全。"",pic:i(1869),page_name:""environmentdetect""},{developItemTitle:""安全隐私检测服务"",developItemText:""基于大数据与AI能力，为开发者提供一站式的安全隐私检测平台，帮助开发者高效，低成本地进行APP隐私合规检测。提供权限分析，SDK分析，隐私法规检测等多种检测服务，为开发者提供专业的整改建议。"",pic:i(1870),page_name:""opdp""},{developItemTitle:""日志防泄漏"",developItemText:""对Android原生日志系统输出的日志进行过滤，防止调试日志或敏感日志泄漏。"",pic:i(1871),page_name:""logdetect""}]},{developTitle:""人工智能"",developItemData:[{developItemTitle:""语音技能"",developItemText:""低成本、高效率的语音技能开发工具平台，一键发布技能，直接触达小布助手用户。"",pic:i(1872),page_name:""voiceskill""},{developItemTitle:""语音服务"",developItemText:""为多终端设备提供智能语音交互体验，一句话唤醒智能生活。"",pic:i(1873),page_name:""voiceservice""},{developItemTitle:""IoT服务"",developItemText:""为厂商提供完善的硬件智能化方案，共建万物互融新时代。"",pic:i(1874),page_name:""Iot""},{developItemTitle:""小布AI"",developItemText:""为开发者提供各项AI原子能力，全面提升开发者运用AI核心能力进行开发的效率。"",pic:i(1875),page_name:""xiaobuai""},{developItemTitle:""数字人"",developItemText:""提供多场景的数字人解决方案，助力开发者快速打造专属数字人服务。"",pic:i(1876),page_name:""digitalman""}]},{developTitle:""开发测试"",developItemData:[{developItemTitle:""远程真机"",developItemText:""提供远程调试能力，通过真机快速定位问题。"",pic:i(1877),page_name:""cloudmachine""},{developItemTitle:""自动化测试"",developItemText:""提供兼容、稳定、性能方面自动化测试方案，快速发现问题。"",pic:i(1878),page_name:""autotest""}]},{developTitle:""高效运营"",developItemData:[{developItemTitle:""钱包服务"",developItemText:""钱包服务是集成手机硬件NFC/SE的技术开放能力，通过整合各类卡证券场景，借助手机便捷、安全、高效触达用户的能力，帮助您实现线上线下一体化的场景服务。"",pic:i(1879),page_name:""pay""},{developItemTitle:""推送服务"",developItemText:""OPPO PUSH 是 ColorOS 上的系统级通道，为开发者提供稳定，高效的消息推送服务。"",pic:i(1880),page_name:""push""},{developItemTitle:""游戏服务"",developItemText:""用于提供游戏内基础的登录、支付服务，同时通过游戏悬浮窗内的运营位、弹窗等用户触达手段，促进用户游戏和付费活跃。"",pic:i(1881),page_name:""gameservice""},{developItemTitle:""账号服务"",developItemText:""OPPO 账号是向开发者提供的，基于 OAuth2.0 标准协议的快捷登录服务， 用户可使用 OPPO 账号更便捷的访问开发者服务。"",pic:i(1882),page_name:""accountservice""}]},{developTitle:""营收变现"",developItemData:[{developItemTitle:""广告联盟"",developItemText:""OPPO 广告联盟是融合增长平台，依托终端优势，秉持健康可持续发展理念，助力开发者达成“流量变现&用户增长”的商业闭环。"",pic:i(1883),page_name:""ada""}]}],visit:{name:""develop"",url:window.location.href}}},mounted:function(){var t=this,e=0;document.documentElement.clientHeight<=937?(e=937-document.documentElement.clientHeight,window.addEventListener(""scroll"",(function(){document.documentElement.scrollTop+document.body.scrollTop>200-e&&(t.runAnimation=!0)}))):t.runAnimation=!0},methods:{changeTabActive:function(t,e){this.tabActive=e,this.$otrack.report({eventId:""oneOPPO_click_introduction_page"",ev